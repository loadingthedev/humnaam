{
  "name": "humnaam",
  "version": "0.1.0",
  "description": "Decides whether two person names are the same person's name, and says why. Built for South Asian and Arabic names in Latin letters.",
  "keywords": [
    "arabic",
    "deduplication",
    "fuzzy-matching",
    "hindi",
    "kyc",
    "name-matching",
    "transliteration",
    "urdu"
  ],
  "homepage": "https://loadingthedev.github.io/humnaam/",
  "license": "MIT",
  "author": "Aftab Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loadingthedev/humnaam.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "format": "oxfmt",
    "bench": "bun bench/run.ts",
    "bench:pairs": "bun bench/pairs.ts",
    "eval:variants": "bun scripts/eval-variants.ts",
    "demo": "bun demo/index.html",
    "demo:build": "bun build demo/index.html --outdir demo/dist --minify",
    "demo:names": "bun demo/names.ts",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm && tsc src/index.ts --ignoreConfig --declaration --emitDeclarationOnly --outDir dist --target esnext --module preserve --strict --skipLibCheck",
    "prepublishOnly": "bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fuzzy-names": "4.8.1",
    "name-match": "1.0.4",
    "name-match-advanced": "1.3.9",
    "oxfmt": "0.78.0",
    "person-name-match": "0.1.3",
    "typescript": "^7"
  }
}
